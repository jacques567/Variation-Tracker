# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# App
NEXT_PUBLIC_APP_URL=https://vartracker.com

# Security — generate with: openssl rand -hex 16
CSRF_SECRET=

# Email (Resend) — used for signature confirmations and variation expiry notifications
RESEND_API_KEY=

# Vercel Cron — generate with: openssl rand -hex 16
# Authorizes /api/cron/* routes; Vercel sends this automatically as a Bearer token
# for scheduled invocations (https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs)
CRON_SECRET=

# Health check — generate with: openssl rand -hex 16
# Send as `Authorization: Bearer <value>` to /api/health to see full diagnostic detail
# (missing env vars, DB error text, config status). Without it, only overall status is returned.
HEALTH_CHECK_SECRET=

# Address lookup (Ideal Postcodes) — off by default, replaces postcodes.io (district-only)
# with full premise-level address autocomplete. Flip NEXT_PUBLIC_USE_IDEAL_POSTCODES to
# "true" once IDEAL_POSTCODES_API_KEY is set (paid — no permanent free tier).
NEXT_PUBLIC_USE_IDEAL_POSTCODES=false
IDEAL_POSTCODES_API_KEY=

# Sentry — error tracking. Leave blank locally; Sentry.init() is a no-op outside production.
# NEXT_PUBLIC_SENTRY_DSN is exposed to the browser (client-side error capture) and
# SENTRY_DSN covers server/edge. Get both from the same Sentry project — they're the same value.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Used only by the Sentry build plugin to upload source maps — not needed for the app to run.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
